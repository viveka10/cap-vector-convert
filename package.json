{
  "name": "cap-hana-vector-publisher",
  "version": "1.2.0",
  "description": "Plug-and-play SAP CAP plugin and library that extracts text from PDF/TXT/MD uploads, chunks it with overlap, stores the chunks with native SAP HANA Cloud vector embeddings (VECTOR_EMBEDDING) and serves upload and similarity search.",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "index.cds",
    "cds-plugin.js",
    "lib/",
    "cds/",
    "db/",
    "srv/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "sap",
    "cap",
    "cds",
    "hana",
    "hana-cloud",
    "vector",
    "embedding",
    "rag",
    "pdf",
    "chunking",
    "cds-plugin"
  ],
  "license": "Apache-2.0",
  "author": "viveka10",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viveka10/cap-vector-convert.git"
  },
  "homepage": "https://github.com/viveka10/cap-vector-convert#readme",
  "bugs": {
    "url": "https://github.com/viveka10/cap-vector-convert/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "pdf-parse": "^1.1.1"
  },
  "peerDependencies": {
    "@sap/cds": ">=7.8"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^0.4.1",
    "@cap-js/sqlite": "^1",
    "@sap/cds": "^8"
  },
  "overrides": {
    "better-sqlite3": "^12"
  },
  "cds": {
    "requires": {
      "kinds": {
        "hana-vector-publisher": {
          "model": "cap-hana-vector-publisher/srv",
          "maxFileSize": 10485760,
          "embedding": {
            "mode": "background",
            "catchUpInterval": 900000
          },
          "search": {
            "defaultTop": 5,
            "maxTop": 50
          },
          "publisher": {}
        }
      }
    }
  }
}
